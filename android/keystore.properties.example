# SayHola Android Release Signing Configuration Example
# To configure release signing:
# 1. Run the automated script: npm run android:keystore (or .\scripts\create-keystore.ps1)
# 2. Or manually copy this file to "android/keystore.properties" and fill in your values.
#
# IMPORTANT:
# - NEVER commit keystore.properties or your .jks file to public git repositories!
# - Both files are already added to .gitignore.

# Path to your .jks keystore file (relative to android/ directory or absolute path)
storeFile=sayhola-release.jks

# Password for the keystore
storePassword=YOUR_KEYSTORE_PASSWORD

# Alias name of the key (default used in scripts is 'sayhola')
keyAlias=sayhola

# Password for the key (often identical to storePassword)
keyPassword=YOUR_KEY_PASSWORD
